<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EnvSettings</RootNamespace>
    <AssemblyName>EnvSettings</AssemblyName>
    <PackageId>EnvSettings</PackageId>
    <Version>0.1.0</Version>
    <Authors>EnvSettings contributors</Authors>
    <Description>Typed application settings bound from .env files and process environment variables.</Description>
    <PackageTags>configuration;dotenv;env;settings;environment</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnvSettings.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotEnv.Core" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
